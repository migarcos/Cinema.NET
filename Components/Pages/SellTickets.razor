@page "/showings/sell/{Id:guid}"

@rendermode InteractiveServer

@using TicketSales.Models
@using TicketSales.Services
@using TicketSales.Components.Shared

@inject ShowingService ShowingService
@inject AuditoriumService AuditoriumService
@inject SaleService SaleService

<PageTitle> Tickets Selling </PageTitle>

<h1> Sell Tickets </h1>

<p>Showing Id: @Id </p>

@if (showing is null)
{
    <p>Showing not found</p>
}
else
{
    <h3> @showing.Movie?.Title </h3>
    <p>@showing.Auditorium?.Name</p>
    <p>
        @showing.Date
        @showing.Time
    </p>
}

@if (auditorium is not null)
{
    <hr />

    <h4>Available Chairs</h4>
    <div class="mb-3">
        <span class="badge bg-success">
            Available
        </span>

        <span class="badge bg-primary ms-2">
            Selected
        </span>

        <span class="badge bg-secondary ms-2">
            Unavailable
        </span>
    </div>
    <ChairLayout Auditorium="@auditorium" SelectedChairs="@selectedChairs" SoldChairs="@soldChairs"
                 OnChairClicked="SelectChair" />
}

<hr />
<h4>Selected Chairs</h4>
@* @if (selectedChairs.Count == 0)
{
    <p>No chairs selected.</p>
}
else
{
    <ul>
        @foreach (var chair in selectedChairs)
        {
            <li>@chair.Row@chair.Number</li>
        }
    </ul>
} *@
@if (selectedChairs.Any())
{
    <p>
        Selected:
        @string.Join(", ",
            selectedChairs.Select(c => $"{c.Row}{c.Number}"))
    </p>
}
<p>
    Tickets:
    @selectedChairs.Count
</p>

<h4>
    Total:
    @Total.ToString("C")
</h4>

<button type="button" class="btn btn-success" disabled="@(!selectedChairs.Any())" @onclick="ConfirmPurchase">
    Confirm Purchase
</button>

@code {
    [Parameter] public Guid Id { get; set; }
    private List<SelectedChair> selectedChairs = [];
    private readonly List<Sale> sales = []; // save purchases in memory
    private List<SoldChair> soldChairs = []; // Load sold seats
    // to calculate ticket total
    private decimal Total => showing is null ? 0 : selectedChairs.Count * showing.TicketPrice;

    private Showing? showing;
    private Auditorium? auditorium;
    protected override void OnParametersSet()
    {
        showing = ShowingService.GetShowing(Id);

        if (showing is not null)
        {
            auditorium = AuditoriumService
                        .GetAuditorium(showing.AuditoriumId);

            soldChairs = SaleService
                        .GetSoldChairsForShowing(showing.Id);
        }
    }

    private void SelectChair(Chair chair)
    {
        var existing = selectedChairs.FirstOrDefault(
            x =>
                x.Row == chair.Row &&
                x.Number == chair.Number);

        if (existing is not null)
        {
            selectedChairs.Remove(existing);
            return;
        }

        selectedChairs.Add(
            new SelectedChair
            {
                Row = chair.Row,
                Number = chair.Number
            });
    }

    private void ConfirmPurchase()
    {
    
        if (showing is null)
            return;

        if (selectedChairs.Count == 0)
            return;

        var existingSoldSeats =
            SaleService.GetSoldChairsForShowing(showing.Id);

        var conflict =
            selectedChairs.Any(selected =>
                existingSoldSeats.Any(sold =>
                    sold.Row == selected.Row &&
                    sold.Number == selected.Number));

        if (conflict)
        {
            return;
        }

        SaleService.CreateSale(
            showing.Id,
            selectedChairs,
            Total);

        selectedChairs.Clear();

        soldChairs = SaleService.GetSoldChairsForShowing(showing.Id);
    }
}