@page "/now-showing"
@rendermode InteractiveServer

@using TicketSales.Models
@using TicketSales.Services

@inject MovieService MovieService

<PageTitle> Now Showing </PageTitle>

<h1>NOW SHOWING</h1>

@if (MovieService.GetMovies().Count == 0)
{
    <p>There are no Movies available </p>
} else
{
    <ul>
        @foreach (var movie in MovieService.GetMovies())
        {
            @* Now show like    • Interstellar - PG-13 - Science Fiction - 169 min *@
            <li> 
                <strong>@movie.Title</strong>
                - @movie.Rating
                - @movie.Genre
                - @movie.DurationMns mins.
            </li>
        }
    </ul>
}

