@page "/movies"
@rendermode InteractiveServer

@using TicketSales.Models
@using TicketSales.Services

@inject MovieService MovieService



<PageTitle>Movies</PageTitle>

<h1>Movies</h1>
<p> Movies Movement Control </p>
<hr />
<h2> Available Movies </h2>
@if (MovieList.Count == 0)
{
    <p> Movies list is Empty! </p>
}
else
{
    <table class="table">
        
    </table>
}
<table class="table">
    <thead>
        <tr>
            <td>TITLE</td>
            <td>RATING</td>
            <td>DURATION</td>
            <td>GENRE</td>
            <td>DESCRIPTION</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in MovieList)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Rating</td>
                <td>@movie.DurationMns</td>
                <td>@movie.Genre</td>
                <td>@movie.Description</td>
            </tr>
        }
    </tbody>
</table>
<hr />
<div>
    <h2>Add Movie</h2>
    @*  EditForm is a Blazor component for forms. Microsoft's documentation explains that 
    EditForm binds to a model and orchestrates validation of Blazor input components. *@
    <EditForm Model="@newMovie" OnValidSubmit="@AddMovie"> @* OnValidSubmit invokes its callback only when form validation succeeds. *@
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Title
                <InputText class="form-control" @bind-Value="newMovie.Title" />
                @* // Display validation errors specifically associated with newMovie.Title. *@
                <ValidationMessage For="@(() => newMovie.Title)" />
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">Rating
                <InputSelect class="form-select" @bind-Value="newMovie.Rating">

                    <option value=""> Select a rating </option>

                    <option value="G">G</option>
                    <option value="PG">PG</option>
                    <option value="PG-13">PG-13</option>
                    <option value="R">R</option>

                </InputSelect>
                <ValidationMessage For="@(() => newMovie.Rating)" />
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">Duration (mins)
                <InputNumber class="form-control" @bind-Value="newMovie.DurationMns" />
                <ValidationMessage For="@(() => newMovie.DurationMns)" />
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">Genre
                <InputSelect class="form-select" @bind-Value="newMovie.Genre">

                    <option value="">  Select a genre </option>
                    
                    <option value="Action">Action</option>
                    <option value="Adventure">Adventure</option>
                    <option value="Animation">Animation</option>
                    <option value="Comedy">Comedy</option>
                    <option value="Drama">Drama</option>
                    <option value="Fantasy">Fantasy</option>
                    <option value="Horror">Horror</option>
                    <option value="Romance">Romance</option>
                    <option value="Science Fiction">Science Fiction</option>
                    <option value="Thriller">Thriller</option>

                </InputSelect>
                <ValidationMessage For="@(() => newMovie.Genre)" />
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">Description
                <InputTextArea class="form-control" rows="4" @bind-Value="newMovie.Description" />
                <ValidationMessage For="@(() => newMovie.Description)" />
            </label>
        </div>

        <button type="submit" class="btn btn-primary"> Add Movie </button>
    </EditForm>
    @* Blazor supplies built-in form input components including 
    InputText, InputNumber, InputSelect, InputDate, InputCheckbox, and InputTextArea. 
    These components bind fields to a model and participate in form validation. *@
</div>
@code {
    private Movie newMovie = new();
    @* private List<Movie> movies = []; *@ // re
    private IReadOnlyList<Movie> MovieList =>
        MovieService.GetMovies();

    @* The form itself built the Movie object. *@
    private void AddMovie()
    {
        MovieService.AddMovie(newMovie);
        newMovie = new Movie();
    }
}
