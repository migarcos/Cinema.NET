@*
    Auditoriums.razor

    Purpose: Allows users to create, edit, delete,
    and update all Auditoriums available in the system.
*@
@page "/auditoriums"
@rendermode InteractiveServer

@using TicketSales.Models
@using TicketSales.Services

@inject AuditoriumService AuditoriumService

<PageTitle> Auditoriums</PageTitle>

<h1> AUDITORIUMS </h1>

<p> Manage the cinema Auditoriums an their seating layouts </p>

<hr />

@if (AuditoriumList.Count == 0)
{
    <p>There are no auditoriums registered yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Rows</th>
                <th>Seats per row</th>
                <th>Capacity</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var auditorium in AuditoriumList)
            {
                <tr>
                    <td>@auditorium.Name</td>
                    <td>@auditorium.Rows</td>
                    <td>@auditorium.ChairsPerRow</td>
                    <td>@auditorium.Chairs.Count</td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm" @onclick="() => EditAuditorium(auditorium)">
                            Edit
                        </button>

                        <button type="button" class="btn btn-danger btn-sm ms-2"
                                @onclick="() => DeleteAuditorium(auditorium.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* @foreach (var auditorium in AuditoriumList)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h3 class="card-title">
                    @auditorium.Name
                </h3>
                <p>
                    Capacity: @auditorium.Chairs.Count chairs
                </p>

                <ChairLayout Auditorium="@auditorium" />
            </div>
        </div>
    } *@
}
<hr />
<h2>Add Auditorium </h2>
@* Add or Update Auditorium form *@
<EditForm Model="@newAuditorium" onValidSubmit="@AddAuditorium" FormName="AuditoriumForm" class="marc">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Auditorium Name
            <InputText class="form-control" @bind-Value="newAuditorium.Name" />
            <ValidationMessage For="@(() => newAuditorium.Name)" />
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">Number of Rows:
            <InputNumber class="form-control" @bind-Value="newAuditorium.Rows" />
            <ValidationMessage For="@(() => newAuditorium.Rows)" />
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">Chairs per Row
            <InputNumber class="form-control" @bind-Value="newAuditorium.ChairsPerRow" />
            <ValidationMessage For="@(() => newAuditorium.ChairsPerRow)" />
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        @(isEditing ? "Update Auditorium" : "Add Auditorium")
    </button>

    </EditForm>


@code {
    private Auditorium newAuditorium = new();
    private bool isEditing; // To track if the instance is Editing
    private IReadOnlyList<Auditorium> AuditoriumList =>
        AuditoriumService.GetAuditoriums();
    private void AddAuditorium()
    {
        if (isEditing)
        {
            AuditoriumService.UpdateAuditorium(newAuditorium);
            isEditing = false;
        }
        else
        {
            AuditoriumService.AddAuditorium(newAuditorium);
        }

        newAuditorium = new Auditorium();
    }

    private void EditAuditorium(Auditorium auditorium)
    {
        newAuditorium = new Auditorium
        {
            Id = auditorium.Id,
            Name = auditorium.Name,
            Rows = auditorium.Rows,
            ChairsPerRow = auditorium.ChairsPerRow
        };

        isEditing = true;
    }

    private void DeleteAuditorium(Guid id)
    {
        AuditoriumService.DeleteAuditorium(id);
    }
}
